<?xml version="1.0" encoding="utf-8"?>
<!-- The code under test is linked into VSNeo.Tests.dll, which coverlet skips by
     default; include it and leave out the tests and stubs themselves. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <Exclude>[VSNeo.Tests]VSNeo.Tests.*,[VSNeo.Tests]Microsoft.*,[VSNeo.Tests]AutoGeneratedProgram</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
