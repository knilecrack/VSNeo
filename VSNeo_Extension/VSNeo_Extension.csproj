<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <!-- ColumnMapper's ASCII scans use pointers (SWAR); the rest of the
         extension stays managed. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <Title>VSNeo</Title>
    <!-- A VSIX is not a NuGet package: GeneratePackageOnBuild produced an
         unused 21 MB .nupkg (and the NU5100 warnings that came with it). -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- local installs need a fresh version for every build, but the version
         lives in a tracked file: bumping it in place left the working tree
         dirty after every F5. BumpVsixVersion bumps a copy in obj/ instead;
         install-local.ps1 sets it, F5 and CI do not (CI stamps the version
         from the run or the tag - see .github/workflows/build.yml). -->
    <BumpVsixVersion Condition="'$(BumpVsixVersion)' == ''">false</BumpVsixVersion>
  </PropertyGroup>

  <!--
    Point the VSIX at the bumped manifest COPY up front. FindSourceVsixManifest
    only discovers a manifest when this item is empty, and it can be invoked
    more than once (the VSSDK calls some targets through CallTarget); adding the
    item inside a target reached only the first invocation and left the tracked
    manifest in the list, which handed MergeVsixManifestSource two items.
  -->
  <ItemGroup Condition="'$(BumpVsixVersion)' == 'true' and '$(CI)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(IntermediateOutputPath)' != ''">
    <SourceVsixManifest Include="$(IntermediateOutputPath)source.extension.vsixmanifest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The companion script ships beside the DLL so it cannot drift out of step
      with the rpcnotify contract the extension expects. IncludeInVSIX puts it in
      the package; CopyToOutputDirectory makes F5 and the test harnesses find it.
    -->
    <Content Include="Lua\vsneo.lua">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Generated from Lua\vsneo\*.lua; edit the modules and run
         Lua\build-vsneo.ps1. The build verifies it is current. -->
    <!-- The manifest's <License> element names this file; it must ship in the VSIX. -->
    <Content Include="..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Same story for the manifest's <Icon>/<PreviewImage>. -->
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
    <!-- Seeky picker (and the msgpack/JSON the extension shares with it):
         compile against these, but ship nothing — Visual Studio loads its own
         copies in devenv, and a second copy in the extension folder is the
         MessagePack landmine all over again. (WebView2 needs the stricter
         IncludeAssets: ExcludeAssets still let its native loader in.) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" IncludeAssets="compile" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" ExcludeAssets="runtime" />
    <!-- Roslyn, for the syntax text objects (Editor/SyntaxTargets.cs). Compile
         only: Visual Studio loads its own Roslyn in-process, and a second copy
         in the VSIX is the MessagePack trap again (see CLAUDE.md). 4.14 is
         what VS 17.14 ships; VS 2026's newer Roslyn binds to it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.EditorFeatures.Text" Version="4.14.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Seeky picker itself. Its DLL ships in the VSIX beside this one
         (ProvideBindingPath on the package lets devenv find it). -->
    <ProjectReference Include="..\VSNeo.Seeky\VSNeo.Seeky.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Seeky commands and their Ctrl+Shift+Alt chords; ProvideMenuResource
         on the package names this resource. -->
    <VSCTCompile Include="VSNeo_Extension.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <!-- The Seeky picker's page ships at Seeky\WebUI beside the DLLs, where
         SeekyPickerWindow looks; its engine is added by IncludeSeekyEngine
         below. A class library's content does not reach a VSIX, so the VSIX
         project packs both. -->
    <Content Include="..\external\Seeky\vs2026\SeekyVS\WebUI\**">
      <Link>Seeky\WebUI\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    seeky-engine.exe, the Seeky picker's fff search engine, runs as a child
    process (VSNeo.Seeky/SeekyEngineClient.cs). It is a .NET 10 project, so it is
    published with the dotnet CLI rather than referenced, and ships under
    Seeky\Engine\ with Tools\fff_c.dll beside it. Needs the .NET 10 SDK.
  -->
  <PropertyGroup>
    <SeekyEngineProject>$(MSBuildProjectDirectory)\..\SeekyEngine\SeekyEngine.csproj</SeekyEngineProject>
    <SeekyEnginePublishDir>$(MSBuildProjectDirectory)\obj\seeky-engine\$(Configuration)\</SeekyEnginePublishDir>
  </PropertyGroup>
  <ItemGroup>
    <SeekyEngineInput Include="..\SeekyEngine\**\*.cs;..\SeekyEngine\*.csproj;..\external\Seeky\vs2026\SeekyVS\*.cs;..\external\Seeky\vs2026\SeekyVS\Tools\fff_c.dll" Exclude="..\SeekyEngine\bin\**;..\SeekyEngine\obj\**" />
  </ItemGroup>
  <Target Name="PublishSeekyEngine" BeforeTargets="BeforeBuild"
          Inputs="@(SeekyEngineInput)" Outputs="$(SeekyEnginePublishDir)seeky-engine.exe">
    <Exec Command="dotnet publish &quot;$(SeekyEngineProject)&quot; -c $(Configuration) -r win-x64 -o &quot;$(SeekyEnginePublishDir.TrimEnd('\'))&quot; --nologo" />
  </Target>
  <Target Name="IncludeSeekyEngine" AfterTargets="PublishSeekyEngine" BeforeTargets="BeforeBuild">
    <!-- Two steps: inside a target, an item's metadata cannot read its own
         %(RecursiveDir) while it is being created - it comes out empty. -->
    <ItemGroup>
      <_SeekyEngineFile Include="$(SeekyEnginePublishDir)**\*" />
      <Content Include="@(_SeekyEngineFile)">
        <Link>Seeky\Engine\%(_SeekyEngineFile.RecursiveDir)%(_SeekyEngineFile.Filename)%(_SeekyEngineFile.Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
        <VSIXSubPath>Seeky\Engine\%(_SeekyEngineFile.RecursiveDir)</VSIXSubPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
    <Error Condition="!Exists('$(SeekyEnginePublishDir)seeky-engine.exe')" Text="seeky-engine.exe was not published to $(SeekyEnginePublishDir)" />
  </Target>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="System.Design" />
    <!-- IWpfTextView.VisualElement is a FrameworkElement; Dispatcher is in WindowsBase. -->
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <!-- WPF controls in the command line margin derive from types that carry it. -->
    <Reference Include="System.Xaml" />
    <!-- A net472 framework assembly: the reference assemblies resolve it, so
         no HintPath (the old one hard-coded C:\Program Files (x86) and broke
         non-default installs). -->
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

  <!--
    BumpVsixVersion=true: give this build a unique version without touching the
    tracked manifest. The copy lives in obj/ and BumpVersion.ps1's state file
    keeps successive local builds increasing, even though every build starts
    from the same source manifest.
  -->
  <Target Name="PrepareBumpedVsixManifest" BeforeTargets="MergeVsixManifestFile"
          Condition="'$(BumpVsixVersion)' == 'true' and '$(CI)' != 'true' and '$(DesignTimeBuild)' != 'true' and '$(_VsixVersionBumped)' != 'true'">
    <PropertyGroup>
      <_VsixManifestSource>$(MSBuildProjectDirectory)\source.extension.vsixmanifest</_VsixManifestSource>
      <_VsixManifestCopy>$(IntermediateOutputPath)source.extension.vsixmanifest</_VsixManifestCopy>
      <!-- obj/, not obj/<Configuration>/: Debug and Release installs land in
           the same Visual Studio, so they must share one increasing version. -->
      <_VsixVersionState>$(BaseIntermediateOutputPath)vsix-version.txt</_VsixVersionState>
      <!-- Set before the work: a CallTarget re-invocation must not bump twice. -->
      <_VsixVersionBumped>true</_VsixVersionBumped>
    </PropertyGroup>
    <Error Condition="'$(IntermediateOutputPath)' == ''"
           Text="BumpVsixVersion needs IntermediateOutputPath; refusing to bump the tracked manifest in place." />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(_VsixManifestSource)" DestinationFiles="$(_VsixManifestCopy)" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\BumpVersion.ps1&quot; &quot;$(_VsixManifestCopy)&quot; -StatePath &quot;$(_VsixVersionState)&quot;" />
  </Target>

  <Target Name="VerifyLuaCompanion" BeforeTargets="BeforeBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Lua\build-vsneo.ps1&quot; -Check" />
  </Target>

  <!--
    VSNeo.Seeky.pdb rides into the output as a project-reference related file,
    and the container copies the output folder. Symbols and source paths do not
    belong in a shipped extension; the pdb stays in bin/ for F5 debugging.
  -->
  <Target Name="ExcludeDebugSymbolsFromVsix" AfterTargets="IncludeVSIXItems"
          BeforeTargets="ValidateVsixParts">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)" Condition="'%(Extension)' == '.pdb'" />
      <VSIXCopyLocalReferenceSourceItem Remove="@(VSIXCopyLocalReferenceSourceItem)"
                                        Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
