<?xml version="1.0" encoding="utf-8"?>
<!--
  The Seeky picker as Visual Studio commands, bound to the Ctrl+Shift+Alt chords
  standalone SeekyVS used. They cannot be nvim mappings: KeyEncoder never sends
  Ctrl+Alt chords to nvim (AltGr on most layouts, and Visual Studio's own binding
  namespace), so these reach Visual Studio's command system in every mode,
  insert included. Rebindable in Tools > Options > Keyboard as Tools.Seeky*;
  vsneo.cmd('Tools.SeekyFindFiles') reaches them by name too.
-->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidVSNeoPackage">
    <Groups>
      <Group guid="guidVSNeoCmdSet" id="SeekyGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyFindFiles" priority="0x0100" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Find Files</ButtonText>
          <CommandName>SeekyFindFiles</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyLiveGrep" priority="0x0101" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Live Grep</ButtonText>
          <CommandName>SeekyLiveGrep</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyGrepWord" priority="0x0102" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Grep Word Under Cursor</ButtonText>
          <CommandName>SeekyGrepWord</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyCurrentFile" priority="0x0103" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Search Current File</ButtonText>
          <CommandName>SeekyCurrentFile</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekySymbols" priority="0x0104" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Workspace Symbols</ButtonText>
          <CommandName>SeekySymbols</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyOutline" priority="0x0105" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Document Outline</ButtonText>
          <CommandName>SeekyDocumentOutline</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyGitModified" priority="0x0106" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Git Modified Files</ButtonText>
          <CommandName>SeekyGitModified</CommandName>
        </Strings>
      </Button>
      <Button guid="guidVSNeoCmdSet" id="cmdidSeekyResume" priority="0x0107" type="Button">
        <Parent guid="guidVSNeoCmdSet" id="SeekyGroup" />
        <Strings>
          <ButtonText>Seeky: Resume Last Picker</ButtonText>
          <CommandName>SeekyResume</CommandName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- Global scope (guidVSStd97), as standalone SeekyVS had them: O/I/G/B/, are its
       letters; L, M and R are new with the embedded picker. -->
  <KeyBindings>
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyFindFiles" editor="guidVSStd97" key1="O" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyLiveGrep" editor="guidVSStd97" key1="I" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyGrepWord" editor="guidVSStd97" key1="G" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyCurrentFile" editor="guidVSStd97" key1="L" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekySymbols" editor="guidVSStd97" key1="VK_OEM_COMMA" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyOutline" editor="guidVSStd97" key1="B" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyGitModified" editor="guidVSStd97" key1="M" mod1="Control Shift Alt" />
    <KeyBinding guid="guidVSNeoCmdSet" id="cmdidSeekyResume" editor="guidVSStd97" key1="R" mod1="Control Shift Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidVSNeoPackage" value="{2213af39-72b4-4827-bda4-da6134c92d0e}" />
    <GuidSymbol name="guidVSNeoCmdSet" value="{6f1b7c3e-4a52-4d8e-9b1f-3c5e7a9d2b40}">
      <IDSymbol name="SeekyGroup" value="0x1000" />
      <IDSymbol name="cmdidSeekyFindFiles" value="0x0100" />
      <IDSymbol name="cmdidSeekyLiveGrep" value="0x0101" />
      <IDSymbol name="cmdidSeekyGrepWord" value="0x0102" />
      <IDSymbol name="cmdidSeekyCurrentFile" value="0x0103" />
      <IDSymbol name="cmdidSeekySymbols" value="0x0104" />
      <IDSymbol name="cmdidSeekyOutline" value="0x0105" />
      <IDSymbol name="cmdidSeekyGitModified" value="0x0106" />
      <IDSymbol name="cmdidSeekyResume" value="0x0107" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
