
" sho line numbers
set relativenumber
set number 
set cursorline
set ignorecase
set smartcase
set hlsearch
set incsearch

set tabstop=4
set shiftwidth=4
set softtabstop=4 shiftwidth=4 expandtab autoindent
set backspace=eol,start,indent
set scrolloff=10

set nostartofline
set autoindent
set expandtab
set ttimeout
set ttimeoutlen=50

set magic
set selection=inclusive

nnoremap <SPACE> <Nop>
let mapleader=" "

" map jj to Esc in Insert mode map.
" inoremap jj <esc>

" Hollow block cursor in insert mode
" set guicursor=i-ci:block-blinkwait700-blinkon400-blinkoff250

" Optional: Keep solid block in normal mode
" set guicursor+=n-v-c:block-Cursor


" Explicitly enable visual mode
" map v v
" nnoremap V V


" nnoremap <C-v> <C-v>
nnoremap <F1> <nop>
inoremap <F1> <nop>
vnoremap <F1> <nop>
nnoremap <C-j> <nop>
inoremap <C-j> <nop>
vnoremap <C-j> <nop>
nnoremap <C-k> <nop>
inoremap <C-k> <nop>
vnoremap <C-k> <nop>
nmap <leader>z :Flash<CR>

nnoremap <leader>s) ciw(<C-r>")<Esc>
nnoremap <leader>s] ciw[<C-r>"]<Esc>
nnoremap <leader>s} ciw{<C-r>"}<Esc>
nnoremap <leader>s> ciw<lt><C-r>"><Esc>
nnoremap <leader>s" ciw"<C-r>""<Esc>
nnoremap <leader>s' ciw'<C-r>"'<Esc>
nnoremap <leader>sw) ciW(<C-r>")<Esc>
nnoremap <leader>sw] ciW[<C-r>"]<Esc>
nnoremap <leader>sw} ciW{<C-r>"}<Esc>
nnoremap <leader>sw> ciW<lt><C-r>"><Esc>
nnoremap <leader>sw" ciW"<C-r>""<Esc>
nnoremap <leader>sw' ciW'<C-r>"'<Esc>

" I need visual mode to be mapped to v as it's not working currently
" map <leader>v v


" Surround visual selected text
vnoremap <leader>S" c"<C-r>""<Esc>
vnoremap <leader>S' c"<C-r>"'<Esc>
vnoremap <leader>S) c(<C-r>")<Esc>
vnoremap <leader>S] c[<C-r>"]<Esc>
vnoremap <leader>S} c{<C-r>"}<Esc>
vnoremap <leader>S> c<lt><C-r>"><Esc>
vnoremap <leader>S* c/*<C-r>"*/<Esc>

"nnoremap <Leader>\ mq^f,`qv%J`qa<CR><Esc>k$%i<CR><Esc>k:s/, *\($\)\@!/,\r<CR>:noh<CR>`qv%=`q
 
 " Type a delimiter for splitting the line into separate lines.
nnoremap <Leader><Leader>\ :s//&\r<Left><Left><Left><Left>
xnoremap <Leader><Leader>\ :s//&\r<Left><Left><Left><Left>


nnoremap <Esc> :nohl<CR>
" nnoremap <leader>vs :source c:\users\mcmau\.vsvimrc<CR>
nnoremap <leader>vs :source c:\users\mcmau\.vsvimrc<CR>:echo "✓ .vsvimrc reloaded!"<CR>

" map zl :so ~/.vsvimrc<CR>
map zl :so ~/.vsvimrc<CR>:echo "✓ .vsvimrc reloaded!"<CR>

nnoremap <leader>a :vsc Edit.GoToAll<CR>
nnoremap <leader>y "+y
vnoremap <leader>y "+y
" imap jj <Left><ESC>
inoremap jj <ESC>

" centers cursor on search
nnoremap n nzz
nnoremap N Nzz
"nnoremap * *zz
"nnoremap # #zz
"nnoremap # "zy?<CR>z<CR>
"xnoremap # "zy?<CR>z<CR>

" Search for selected text.
" xnoremap * "zy/<C-R>z<CR>
" xnoremap # "zy?<C-R>z<CR>

nnoremap Y y$

" replace currently selected text with default register
" without yanking it
vnoremap <leader>p "_dP

nnoremap <leader>, :vsc Window.PreviousDocumentWindow<CR>
nnoremap <leader>. :vsc Window.NextDocumentWindow<CR>
nnoremap <leader>mp :vsc Window.MoveToPreviousTabGroup<CR>
nnoremap <leader>mx :vsc Window.MoveToNextTabGroup<CR>
