<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>VSNeo.Benchmarks</RootNamespace>
    <AssemblyName>VSNeo.Benchmarks</AssemblyName>
    <!-- Links extension sources, so IDE analyzers see a different context than
         the real build. Formatting is gated separately with dotnet format. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MsgPack.Reader.cs" Link="Linked\MsgPack.Reader.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MsgPack.Writer.cs" Link="Linked\MsgPack.Writer.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MsgPack.StreamReader.cs" Link="Linked\MsgPack.StreamReader.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimHandle.cs" Link="Linked\NvimHandle.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\KeymapCatalog.cs" Link="Linked\KeymapCatalog.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\PromptState.cs" Link="Linked\PromptState.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\SearchState.cs" Link="Linked\SearchState.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MarksState.cs" Link="Linked\MarksState.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\KeyRoutingRules.cs" Link="Linked\KeyRoutingRules.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimStateHub*.cs" Link="Linked\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimStateTypes.cs" Link="Linked\NvimStateTypes.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\SpanEncoder.cs" Link="Linked\SpanEncoder.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\Log.cs" Link="Linked\Log.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\ColumnMapper.cs" Link="Linked\ColumnMapper.cs" />
    <Compile Include="..\VSNeo.Tests\Stubs\TextStubs.cs" Link="Linked\TextStubs.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
