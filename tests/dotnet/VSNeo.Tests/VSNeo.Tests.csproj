<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>VSNeo.Tests</RootNamespace>
    <!-- Links extension sources and adds global usings, so IDE analyzers see a
         different context than the real build (IDE0005 especially). Formatting
         is gated separately with dotnet format. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MsgPack.Reader.cs" Link="Linked\MsgPack.Reader.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MsgPack.Writer.cs" Link="Linked\MsgPack.Writer.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MsgPack.StreamReader.cs" Link="Linked\MsgPack.StreamReader.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimHandle.cs" Link="Linked\NvimHandle.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimRpcClient.cs" Link="Linked\NvimRpcClient.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimRpcClient.Answer.cs" Link="Linked\NvimRpcClient.Answer.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimRpcClient.Connect.cs" Link="Linked\NvimRpcClient.Connect.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimRpcClient.Receive.cs" Link="Linked\NvimRpcClient.Receive.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimRpcClient.Send.cs" Link="Linked\NvimRpcClient.Send.cs" />
    <!-- Globbed: the hub is split across partials, and the tests compile the class to drive OnNotification. -->
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimStateHub*.cs" Link="Linked\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\NvimStateTypes.cs" Link="Linked\NvimStateTypes.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\KeymapCatalog.cs" Link="Linked\KeymapCatalog.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\PromptState.cs" Link="Linked\PromptState.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\SearchState.cs" Link="Linked\SearchState.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\MarksState.cs" Link="Linked\MarksState.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\KeyRoutingRules.cs" Link="Linked\KeyRoutingRules.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\VsCommandCatalog.cs" Link="Linked\VsCommandCatalog.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Nvim\SpanEncoder.cs" Link="Linked\SpanEncoder.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\Log.cs" Link="Linked\Log.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\ProcessJob.cs" Link="Linked\ProcessJob.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\ColumnMapper.cs" Link="Linked\ColumnMapper.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\FoldRows.cs" Link="Linked\FoldRows.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Infrastructure\RelativeLineNumberPolicy.cs" Link="Linked\RelativeLineNumberPolicy.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\SolutionExplorerVimKeys.cs" Link="Linked\SolutionExplorerVimKeys.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\RemoteLineEdit.cs" Link="Linked\RemoteLineEdit.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\Cursor\TrailMotionRules.cs" Link="Linked\TrailMotionRules.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\Cursor\CursorStyleDecision.cs" Link="Linked\CursorStyleDecision.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\InsertUndoGroup.cs" Link="Linked\InsertUndoGroup.cs" />
    <Compile Include="..\..\..\external\Seeky\vs2026\SeekyVS\FuzzyMatcher.cs" Link="Linked\FuzzyMatcher.cs" />
    <Compile Include="..\..\..\VSNeo.Seeky\LineSearch.cs" Link="Linked\LineSearch.cs" />
    <!-- Globbed: the client is split into partials and the tests compile it. -->
    <Compile Include="..\..\..\VSNeo.Seeky\SeekyEngineClient*.cs" Link="Linked\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\VSNeo.Seeky\SeekySymbolCollapse.cs" Link="Linked\SeekySymbolCollapse.cs" />
    <Compile Include="..\..\..\VSNeo.Seeky\SeekyAppearanceSettings.cs" Link="Linked\SeekyAppearanceSettings.cs" />
    <Compile Include="..\..\..\VSNeo.Seeky\SeekyQuickfixAction.cs" Link="Linked\SeekyQuickfixAction.cs" />
    <Compile Include="..\..\..\external\Seeky\vs2026\SeekyVS\SeekyRange.cs" Link="Linked\SeekyRange.cs" />
    <Compile Include="..\..\..\VSNeo.Seeky\SeekyLog.cs" Link="Linked\SeekyLog.cs" />
    <Compile Include="..\..\..\VSNeo.Seeky\SeekyHost.cs" Link="Linked\SeekyHost.cs" />
    <Compile Include="..\..\..\SeekyEngine\TextClip.cs" Link="Linked\TextClip.cs" />
    <!-- FuzzyMatcher and SeekyRange are Seeky's own (namespace SeekyVS), as in VSNeo.Seeky. -->
    <Using Include="SeekyVS" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\SyntaxTargets.cs" Link="Linked\SyntaxTargets.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\CodeModelTargets.cs" Link="Linked\CodeModelTargets.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\Keys\CommandKeyTable.cs" Link="Linked\CommandKeyTable.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\Keys\CtrlODecision.cs" Link="Linked\CtrlODecision.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\Keys\InsertKeyDecision.cs" Link="Linked\InsertKeyDecision.cs" />
    <Compile Include="..\..\..\VSNeo_Extension\Editor\Keys\PasteDecision.cs" Link="Linked\PasteDecision.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- SyntaxTargets runs on Roslyn's tree; the same version the extension compiles against. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- XPlat Code Coverage for the CI unit job. -->
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
