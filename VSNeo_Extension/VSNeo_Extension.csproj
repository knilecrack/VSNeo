<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>

    <!-- VSIX settings -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <Title>VSNeo</Title>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- NuGet authoring best practice: ship the repo readme inside the nupkg. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Bump the VSIX version before every local build so installs/upgrades are
         unambiguous. CI stamps the version from the run/tag instead (see
         .github/workflows/build.yml), so the bump steps aside there. -->
    <PreBuildEvent Condition="'$(CI)' != 'true'">powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\BumpVersion.ps1" "$(MSBuildProjectDirectory)\source.extension.vsixmanifest"</PreBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!--
      The companion script ships beside the DLL so it cannot drift out of step
      with the rpcnotify contract the extension expects. IncludeInVSIX puts it in
      the package; CopyToOutputDirectory makes F5 and the test harnesses find it.
    -->
    <Content Include="Lua\vsneo.lua">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The manifest's <License> element names this file; it must ship in the VSIX. -->
    <Content Include="..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Same story for the manifest's <Icon>/<PreviewImage>. -->
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820" />
    <!-- Seeky picker: compile against these, but ship nothing — Visual Studio
         loads its own copies in devenv, and a second copy in the extension
         folder is the MessagePack landmine all over again. (WebView2 needs the
         stricter IncludeAssets: ExcludeAssets still let its native loader in.) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" IncludeAssets="compile" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Seeky commands and their Ctrl+Shift+Alt chords; ProvideMenuResource
         on the package names this resource. -->
    <VSCTCompile Include="VSNeo_Extension.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>
  <ItemGroup>
    <!-- The Seeky picker's page and search engine ship beside the DLL. -->
    <Content Include="Seeky\WebUI\**">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Seeky\Tools\fff_c.dll">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="System.Design" />
    <!-- IWpfTextView.VisualElement is a FrameworkElement; Dispatcher is in WindowsBase. -->
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <!-- WPF controls in the command line margin derive from types that carry it. -->
    <Reference Include="System.Xaml" />
    <Reference Include="System.ComponentModel.Composition">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.ComponentModel.Composition.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
