<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="VSNeo-ec21d06f-8395-403c-99b0-f2c417442403" Version="1.4.151" Language="en-US" Publisher="knilecrack" />
    <DisplayName>VSNeo - Neovim for Visual Studio</DisplayName>
    <Description xml:space="preserve">A real Neovim inside Visual Studio, not a Vim emulator. Your own nvim.exe runs every motion, operator, register, macro and :command; Visual Studio keeps IntelliSense, refactorings, Copilot and undo. VsVim alternative with plugins, a floating command line, a fuzzy picker and Neovide-style cursor effects.</Description>
    <License>LICENSE.txt</License>
    <Icon>icon.png</Icon>
    <PreviewImage>icon.png</PreviewImage>
    <Tags>Vim, Neovim, nvim, modal editing, editor, keyboard</Tags>
    <Preview>true</Preview>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14, )">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" Version="[4.5,)" d:Source="Manual" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" DisplayName="Visual Studio core editor" Version="[17.14, )" />
  </Prerequisites>
  <Assets>
    <!--
      Without this the MEF parts are never composed: the key processor, the text
      view creation listener and the cursor synchronizer all export through MEF,
      and the empty VSIX template does not include this asset. The extension
      installs, the package loads, and not one keystroke is intercepted.
    -->
    <Asset Type="Microsoft.VisualStudio.VsPackage" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" d:Source="Project" d:ProjectName="%CurrentProject%" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" Path="|%CurrentProject%|" d:Source="Project" d:ProjectName="%CurrentProject%" />
  </Assets>
</PackageManifest>